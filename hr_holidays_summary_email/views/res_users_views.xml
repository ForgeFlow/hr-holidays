<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="res_users_view_form_preferences" model="ir.ui.view">
        <field
            name="name"
        >res.users.preferences.form.inherit - hr_holidays_summary_email</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_preferences" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="hr_leave_summary_type" invisible="not employee_id" />
            </xpath>
        </field>
    </record>
</odoo>
