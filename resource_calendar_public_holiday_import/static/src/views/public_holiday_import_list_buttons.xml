<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="resource_calendar_public_holiday_import.ListButtons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <button
                type="button"
                class="btn btn-secondary o_button_import_public_holiday"
                t-on-click="() => this.openImportPublicHolidayWizard()"
            >
                Import
            </button>
        </xpath>
    </t>
</templates>
